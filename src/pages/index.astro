---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Hobbies from "../components/Hobbies.astro";
import Contact from "../components/Contact.astro";
import Handshake from "../components/Handshake.astro";
import BackToTop from "../components/BackToTop.astro";
---

<Layout
  title="Evan Ye — CS Portfolio"
  description="Computer science portfolio for Evan Ye, a CS student at Yale."
>
  <div class="room">
    <div class="stars" id="stars" aria-hidden="true"></div>
    <Navigation />
    <Hero />
    <main>
      <Projects />
      <Hobbies />
      <Contact />
      <Handshake />
    </main>
    <BackToTop />
  </div>
</Layout>

<style>
  /* Page frame. The sections sit above the shooting stars. */
  .room {
    position: relative;
    min-height: 100svh;
    overflow-x: clip;
  }

  .nav,
  .hero,
  main {
    position: relative;
    z-index: 1;
  }
</style>
