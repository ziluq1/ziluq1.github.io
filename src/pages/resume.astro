---
import Layout from "../layouts/Layout.astro";
import { EMAIL } from "../data/site";
---

<Layout
  title="Evan Ye — Resume"
  description="Placeholder resume for Evan Ye."
>
  <main class="resume-page">
    <article class="resume-doc" aria-label="Resume placeholder">
      <header class="resume-head">
        <h1>Evan Ye</h1>
        <p>Yale College · Computer Science &amp; Math</p>
        <p>{EMAIL}</p>
      </header>

      <section>
        <h2>Education</h2>
        <p class="line">Yale College</p>
        <p class="ghost"></p>
      </section>

      <section>
        <h2>Experience</h2>
        <p class="ghost"></p>
        <p class="ghost short"></p>
        <p class="ghost"></p>
      </section>

      <section>
        <h2>Projects</h2>
        <p class="ghost"></p>
        <p class="ghost short"></p>
      </section>

      <p class="resume-stamp" aria-hidden="true">Placeholder</p>
    </article>
  </main>
</Layout>

<style>
  .resume-page {
    min-height: 100svh;
    display: grid;
    place-items: start center;
    padding:
      max(1.25rem, env(safe-area-inset-top))
      max(1rem, env(safe-area-inset-right))
      max(1.5rem, env(safe-area-inset-bottom))
      max(1rem, env(safe-area-inset-left));
    background: color-mix(in srgb, var(--ink) 8%, var(--paper));
  }

  .resume-doc {
    position: relative;
    width: min(52rem, 100%);
    min-height: min(68rem, calc(100svh - 2.5rem));
    padding: clamp(1.4rem, 4vw, 3.25rem);
    background: #fbf8f2;
    color: var(--ink);
    box-shadow: 0 16px 40px rgba(28, 25, 21, 0.12);
    overflow: hidden;
  }

  .resume-head {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
  }

  .resume-head h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(2rem, 6vw, 3.2rem);
  }

  .resume-head p,
  .resume-doc section p {
    margin: 0.2rem 0 0;
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .resume-doc section {
    margin-top: 1.6rem;
  }

  .resume-doc h2 {
    margin: 0 0 0.65rem;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ghost {
    height: 0.7rem;
    margin-top: 0.7rem;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .ghost.short {
    width: 62%;
  }

  .resume-stamp {
    position: absolute;
    left: 50%;
    top: 34%;
    margin: 0;
    padding: 0.35rem 1.15rem;
    border: 4px solid #b42318;
    color: #b42318;
    font-family: var(--mono);
    font-size: clamp(1.8rem, 8vw, 4.4rem);
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
    transform: translate(-50%, -50%) rotate(-18deg);
    pointer-events: none;
    opacity: 0.82;
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .resume-doc {
      min-height: auto;
      padding-bottom: 4rem;
    }

    .resume-stamp {
      letter-spacing: 0.08em;
    }
  }
</style>
