---
import { PROFILE_IMAGE_PATH } from "../data/site";
import PullCord from "./PullCord.astro";
---

<!-- Name, portrait, and the cord that switches the lights. -->
<section class="hero" id="top">
  <PullCord />

  <div class="hero-main">
    <div class="portrait">
      <div class="fixture">
        <div class="glow" aria-hidden="true"></div>
        <div class="lamp">
          <div class="plaque">
            <img src={PROFILE_IMAGE_PATH} alt="Photo of Evan Ye" />
          </div>
        </div>
      </div>
      <p class="kicker">Computer Science & Math</p>
    </div>

    <div class="intro">
      <h1>Evan Ye</h1>
      <p class="lede">
        Hi! I’m Evan, a Yale ’30 student from Louisiana studying Computer Science & Math. I’m interested in coding, building projects, and making games. Outside of tech, I enjoy playing squash or tennis, hiking, traveling, and listening to music
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    --pull: 0px;
    position: relative;
    min-height: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding:
      0
      max(6vw, env(safe-area-inset-right))
      4.75rem
      max(6vw, env(safe-area-inset-left));
  }

  .hero-main {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    align-items: center;
    gap: 4.25rem;
    width: min(1000px, 100%);
    margin: 2.75rem auto 0;
  }

  .glow {
    pointer-events: none;
    position: absolute;
    z-index: 0;
    left: 50%;
    top: 46%;
    width: clamp(220px, 78vw, 480px);
    height: clamp(200px, 62vw, 420px);
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse at center, var(--glow), transparent 68%);
  }

  .portrait {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    transform: translateY(-1.35rem);
  }

  .portrait .kicker {
    text-align: center;
    max-width: 100%;
  }

  .fixture {
    position: relative;
    width: 100%;
    margin: 0;
  }

  .lamp {
    position: relative;
    z-index: 1;
  }

  .plaque {
    display: grid;
    width: 100%;
    aspect-ratio: 1;
    padding: 6px;
    background: #f8f3ea;
    color: #1c1915;
    box-shadow:
      0 18px 50px rgba(0, 0, 0, 0.28),
      0 2px 0 rgba(255, 255, 255, 0.35) inset,
      var(--plaque-halo, 0 0 0 transparent);
    transition:
      filter 700ms ease,
      background 700ms ease,
      color 700ms ease,
      transform 500ms ease,
      box-shadow 700ms ease;
  }

  .plaque img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  :global(body[data-theme="dark"]) .plaque {
    --plaque-halo:
      0 0 28px rgba(255, 255, 255, 0.08),
      0 16px 56px rgba(180, 200, 255, 0.15);
  }

  :global(body[data-theme="dark"]) .glow {
    width: 165%;
    height: 165%;
    background: radial-gradient(
      ellipse at center,
      rgba(180, 200, 255, 0.28),
      rgba(255, 255, 255, 0.1) 38%,
      transparent 68%
    );
  }

  .intro {
    width: 100%;
    min-width: 0;
    margin: 0;
    text-align: left;
  }

  .lede {
    margin: 0;
    max-width: 55ch;
    line-height: 1.55;
    text-align: left;
    color: var(--muted);
    overflow-wrap: break-word;
  }

  @media (max-width: 768px) {
    .hero-main {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 2.4rem;
      margin-top: 0;
    }

    .fixture {
      width: 168px;
      margin-top: 5.5rem;
    }

    .intro {
      text-align: center;
    }

    .lede {
      margin-inline: auto;
      text-align: center;
      text-wrap: pretty;
    }

    .hero {
      min-height: auto;
      padding-bottom: 3.25rem;
    }
  }

  /* Short landscape phones and small tablets keep the name on screen. */
  @media (max-width: 1024px) and (max-height: 520px) {
    .hero-main {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 1.1rem;
      margin-top: 0.6rem;
    }

    .fixture {
      width: min(168px, 36dvh);
      margin-top: 0;
    }

    .intro,
    .lede {
      text-align: center;
    }

    .lede {
      margin-inline: auto;
    }

    .hero {
      min-height: auto;
      padding-bottom: 1.5rem;
    }
  }
</style>
