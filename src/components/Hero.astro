---
import { PROFILE_IMAGE_PATH } from "../data/site";
import PullCord from "./PullCord.astro";
---

<!-- Name, portrait, and the cord that switches the lights. -->
<section class="hero" id="top">
  <PullCord />

  <div class="fixture" id="fixture">
    <div class="glow" aria-hidden="true"></div>
    <div class="lamp">
      <div class="plaque">
        <img src={PROFILE_IMAGE_PATH} alt="Photo of Evan Ye" />
      </div>
    </div>
  </div>

  <div class="intro">
    <p class="kicker">Computer Science</p>
    <h1>Evan Ye</h1>
    <p class="lede">
      Hi! I’m Evan, a Yale Computer Science undergraduate who likes to build things, solve problems,<span class="lede-gap">&nbsp;</span><br class="lede-break" />
      and mess around with code.
    </p>
  </div>
</section>

<style>
  .hero {
    --pull: 0px;
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding:
      0
      max(6vw, env(safe-area-inset-right))
      3rem
      max(6vw, env(safe-area-inset-left));
  }

  .glow {
    pointer-events: none;
    position: absolute;
    z-index: 0;
    left: 50%;
    top: 46%;
    width: clamp(220px, 78vw, 480px);
    height: clamp(200px, 62vw, 420px);
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse at center, var(--glow), transparent 68%);
  }

  .fixture {
    position: relative;
    width: 220px;
    margin: 2.75rem auto 0;
  }

  .lamp {
    position: relative;
    z-index: 1;
  }

  .plaque {
    display: grid;
    width: 100%;
    aspect-ratio: 1;
    padding: 6px;
    background: #f8f3ea;
    color: #1c1915;
    box-shadow:
      0 18px 50px rgba(0, 0, 0, 0.28),
      0 2px 0 rgba(255, 255, 255, 0.35) inset;
    transition:
      filter 700ms ease,
      background 700ms ease,
      color 700ms ease,
      transform 500ms ease;
  }

  .plaque img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  :global(body[data-theme="dark"]) .plaque {
    background: #14151c;
    color: #f3ecdf;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
  }

  .intro {
    width: min(45rem, 100%);
    margin: 2.4rem auto 0;
    text-align: center;
  }

  .lede {
    margin: 0 auto;
    max-width: min(44rem, 100%);
    line-height: 1.55;
    text-align: left;
    color: var(--muted);
    overflow-wrap: break-word;
  }

  /* The gap is only for phones. Wider screens break the line instead. */
  .lede-gap {
    display: none;
  }

  /* Phones wrap the sentence. Wider screens keep the second line starting at the left. */
  @media (max-width: 700px) {
    .lede-gap {
      display: inline;
    }

    .lede-break {
      display: none;
    }

    .lede {
      text-wrap: pretty;
    }

    .fixture {
      width: 168px;
      margin: 5.5rem auto 0;
    }
  }

  /* Short landscape screens keep the name on screen. */
  @media (max-height: 520px) {
    .hero {
      min-height: auto;
      padding-bottom: 1.5rem;
    }

    .fixture {
      width: min(168px, 36vh);
      margin-top: 0.6rem;
    }

    .intro {
      margin-top: 1.1rem;
    }
  }
</style>
