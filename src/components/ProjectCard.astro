---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;

function filled(value?: string) {
  return Boolean(value?.trim());
}

const image = filled(project.image) ? project.image!.trim() : "";
const github = filled(project.github) ? project.github!.trim() : "";
const demo = filled(project.demo) ? project.demo!.trim() : "";
const technologies = Array.isArray(project.technologies)
  ? project.technologies.map((item) => item.trim()).filter(Boolean)
  : [];
---

<!-- One card. Empty image, GitHub, demo, and technology fields are left out. -->
<article class="project-card">
  <div class="project-media">
    {
      image ? (
        <img src={image} alt={project.imageAlt?.trim() || project.title} />
      ) : (
        project.status && <span>{project.status}</span>
      )
    }
  </div>
  <div class="project-copy">
    {project.year && <span class="project-year">{project.year}</span>}
    <h3>{project.title}</h3>
    {project.description && <p>{project.description}</p>}
    {technologies.length > 0 && <p class="project-tags">{technologies.join(" · ")}</p>}
    {
      (github || demo) && (
        <p class="project-links">
          {github && (
            <a href={github} target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          )}
          {demo && (
            <a href={demo} target="_blank" rel="noopener noreferrer">
              Demo
            </a>
          )}
        </p>
      )
    }
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(11rem, 0.7fr);
    gap: 1.25rem;
    align-items: stretch;
    min-width: 0;
    margin-top: 1.15rem;
    background: color-mix(in srgb, var(--card) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
    box-shadow: 0 8px 18px rgba(28, 25, 21, 0.06);
    overflow: hidden;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  @media (hover: hover) {
    .project-card:hover {
      transform: translateY(-4px);
      border-color: color-mix(in srgb, var(--fg) 32%, transparent);
      box-shadow: 0 14px 28px rgba(28, 25, 21, 0.12);
    }
  }

  .project-media {
    min-height: 240px;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: color-mix(in srgb, var(--fg) 4%, transparent);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.1rem 1.25rem 1.15rem 0;
  }

  .project-copy h3 {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-year,
  .project-copy p,
  .project-tags,
  .project-links {
    margin: 0.35rem 0 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    line-height: 1.45;
    color: var(--muted);
  }

  .project-links {
    display: flex;
    gap: 0.85rem;
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  @media (hover: hover) {
    .project-links a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .project-links a:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }

  @media (max-width: 1024px) {
    .project-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .project-copy {
      padding: 0.9rem 1rem 1rem;
    }
  }

  @media (max-width: 700px) {
    .project-media {
      min-height: 180px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card:hover {
      transition: none;
      animation: none;
      transform: none;
    }
  }
</style>
