---
import { EMAIL, GMAIL_URL, LINKEDIN_URL, RESUME_PATH } from "../data/site";
---

<section class="panel contact" id="contact">
  <p class="kicker">Contact</p>
  <h2>Leave a message.</h2>
  <div class="contact-actions">
    <a class="contact-btn" href={GMAIL_URL} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="1.5" />
        <path d="M4 7l8 6 8-6" />
      </svg>
      {EMAIL}
    </a>
    <a class="contact-btn" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <path d="M8 10v7M8 7h.01M12 17v-4.5a2 2 0 0 1 4 0V17" />
      </svg>
      LinkedIn
    </a>
    <a class="contact-btn" href={RESUME_PATH} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" />
        <path d="M14 3v5h5M8 13h8M8 17h8" />
      </svg>
      Resume
    </a>
  </div>
  <p class="contact-direct">Contact me directly</p>
</section>

<style>
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    max-width: 100%;
    padding: 0.7rem 1rem;
    border: 2px solid #111;
    background: transparent;
    color: #111;
    font-size: 0.95rem;
    line-height: 1.2;
    text-align: center;
    overflow-wrap: anywhere;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease;
  }

  .contact-btn svg {
    width: 1rem;
    height: 1rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-btn:hover {
    transform: translateY(-2px);
    background: rgba(0, 0, 0, 0.05);
  }

  .contact-btn:focus-visible {
    outline: 2px solid #111;
    outline-offset: 3px;
  }

  :global(body[data-theme="dark"]) .contact-btn {
    border-color: #fff;
    color: #fff;
  }

  :global(body[data-theme="dark"]) .contact-btn:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  :global(body[data-theme="dark"]) .contact-btn:focus-visible {
    outline-color: #fff;
  }

  .contact-direct {
    margin: 0.85rem 0 0;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    opacity: 0.65;
  }

  @media (max-width: 700px) {
    .contact-actions {
      flex-direction: column;
      align-items: center;
    }

    .contact-btn {
      width: min(100%, 22rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-btn,
    .contact-btn:hover {
      transition: none;
      animation: none;
      transform: none;
    }
  }
</style>
